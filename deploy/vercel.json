    {
      "source": "/uz/contacts/",
      "destination": "/uz/#contacts",
      "permanent": true
    },
    {
      "source": "/uz/project/",
      "destination": "/uz/",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/installment/",
