---
/* Ветка вишни в тонах шампани — аналог видео бугенвиллеи ERA. Картинка — кадр заказчика
   (renders/make-branch.py): ствол входит в кадр слева сверху, у картинки срезаны левый и верхний край:
   side="l"  — срез слева-сверху, ставим к левому краю экрана (или за фото слева);
   side="r"  — срез справа-сверху, к правому краю;
   side="lb" / "rb" — то же, ветка снизу.
   Живёт ветка в WebGL (scripts/branch.js): гнётся от места крепления, цветки дрожат, лепестки
   срываются и падают — холст .flower_gl добавляет скрипт. Картинка остаётся на месте: до первого
   кадра анимации, без WebGL и при «меньше движения» (тогда она покачивается в CSS вокруг среза).
   style задаёт положение и ширину (высота — по пропорциям ветки 1520×793); z — слой (например,
   под фотографией); depth — глубина для параллакса (scripts/blossom.js): < 0 — передний план,
   едет быстрее ленты/страницы; > 0 — дальний, медленнее. */
interface Props { style: string; side?: 'l' | 'r' | 'lb' | 'rb'; z?: number; depth?: number }
const { style, side = 'l', z, depth } = Astro.props;
const origin = { l: '0% 16%', r: '100% 16%', lb: '0% 84%', rb: '100% 84%' }[side];   /* где ствол входит в кадр */
const css = style + ';--fo:' + origin + (z !== undefined ? ';z-index:' + z : '');
const base = '/img/scenes/branch-' + side;
---
<div class={'flower is-' + side} style={css} aria-hidden="true" data-flower data-side={side} data-depth={depth}>
  <img src={base + '-960.webp'} srcset={base + '-480.webp 480w, ' + base + '-960.webp 960w, ' + base + '-1520.webp 1520w'} sizes="(max-width: 991px) 60vw, 45vw" alt="" loading="lazy" decoding="async" width="1520" height="793" />
</div>
