---
/* Круглая кнопка ERA (.btn-circle): подпись l1 в центре, две короткие дуги
   удлиняются при наведении, магнит на десктопе. href — ссылка; dialog — открыть
   окно записи на встречу. butterfly — бабочка прилетает и садится на край круга
   (scripts/butterfly.js; сейчас — только «Изучить расположение»). */
interface Props { label: string; href?: string; dialog?: boolean; size?: 'l' | 'm'; class?: string; butterfly?: boolean }
const { label, href, dialog = false, size = 'l', class: cls = '', butterfly = false } = Astro.props;
/* бабочка по образцу заказчика (28.09: акварельные бабочки с округлыми крыльями) в тонах бренда:
   крыло светлое у тела и плотнее к краю, тёмная кайма, тонкие прожилки, у заднего крыла — «хвостик».
   Вид сверху, голова вверх: два крыла (левое — зеркало правого), тело, усики.
   data-wing — взмахи (JS в полёте, CSS в покое). */
const BFLY = '<svg viewBox="0 0 64 52" width="100%" height="100%"><defs><radialGradient id="bflyF" cx="33" cy="22" r="31" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FCF7EE"/><stop offset=".5" stop-color="#F0E0C2"/><stop offset=".8" stop-color="#DDBF8C"/><stop offset=".93" stop-color="#C39A5A"/><stop offset="1" stop-color="#A97D3C"/></radialGradient><radialGradient id="bflyH" cx="33" cy="29" r="22" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FCF7EE"/><stop offset=".55" stop-color="#EFDDBD"/><stop offset=".85" stop-color="#D5B27A"/><stop offset="1" stop-color="#B58947"/></radialGradient></defs><g class="bfly_wing" data-wing><g transform="matrix(-1 0 0 1 64 0)"><path d="M33 19.5C35.5 13 42 6.5 50.5 4.2C55.5 2.9 60.8 3.3 62.3 6.2C63.4 8.5 61.2 11.2 59.4 13.6C57 16.8 56.4 20.8 52.6 23.6C47.8 27 40 27.6 33 26.2Z" fill="url(#bflyF)"/><path d="M33 27C38.6 27.4 45.6 28.6 49.6 32C53.2 35.2 52.8 40.2 49.2 42.6C46.6 44.4 43.4 44.2 41.8 46.4C41 47.6 40.6 49.6 39.4 50.4C38.6 49 38.4 47.2 37.6 45.6C35.8 41.6 33.8 36.4 33 31.2Z" fill="url(#bflyH)"/><ellipse cx="46" cy="13.5" rx="7.5" ry="3.6" transform="rotate(-24 46 13.5)" fill="#FFFDF7" fill-opacity=".38"/><ellipse cx="42.5" cy="35" rx="4.6" ry="2.6" transform="rotate(32 42.5 35)" fill="#FFFDF7" fill-opacity=".3"/><path d="M34 21C40 16 47 11 56 7M34 23.5C41 21 48 18.4 57.5 15M34 25.4C40 25 46 24 52 22M34 29C39 32 43 36 47 41M34 28C40 29 45 31 49.5 34" fill="none" stroke="#9E7437" stroke-opacity=".22" stroke-width=".35" stroke-linecap="round"/><path d="M33 19.5C35.5 13 42 6.5 50.5 4.2C55.5 2.9 60.8 3.3 62.3 6.2C63.4 8.5 61.2 11.2 59.4 13.6C57 16.8 56.4 20.8 52.6 23.6C47.8 27 40 27.6 33 26.2ZM33 27C38.6 27.4 45.6 28.6 49.6 32C53.2 35.2 52.8 40.2 49.2 42.6C46.6 44.4 43.4 44.2 41.8 46.4C41 47.6 40.6 49.6 39.4 50.4C38.6 49 38.4 47.2 37.6 45.6C35.8 41.6 33.8 36.4 33 31.2Z" fill="none" stroke="#9E7437" stroke-opacity=".5" stroke-width=".7" stroke-linejoin="round"/></g></g><g class="bfly_wing" data-wing><path d="M33 19.5C35.5 13 42 6.5 50.5 4.2C55.5 2.9 60.8 3.3 62.3 6.2C63.4 8.5 61.2 11.2 59.4 13.6C57 16.8 56.4 20.8 52.6 23.6C47.8 27 40 27.6 33 26.2Z" fill="url(#bflyF)"/><path d="M33 27C38.6 27.4 45.6 28.6 49.6 32C53.2 35.2 52.8 40.2 49.2 42.6C46.6 44.4 43.4 44.2 41.8 46.4C41 47.6 40.6 49.6 39.4 50.4C38.6 49 38.4 47.2 37.6 45.6C35.8 41.6 33.8 36.4 33 31.2Z" fill="url(#bflyH)"/><ellipse cx="46" cy="13.5" rx="7.5" ry="3.6" transform="rotate(-24 46 13.5)" fill="#FFFDF7" fill-opacity=".38"/><ellipse cx="42.5" cy="35" rx="4.6" ry="2.6" transform="rotate(32 42.5 35)" fill="#FFFDF7" fill-opacity=".3"/><path d="M34 21C40 16 47 11 56 7M34 23.5C41 21 48 18.4 57.5 15M34 25.4C40 25 46 24 52 22M34 29C39 32 43 36 47 41M34 28C40 29 45 31 49.5 34" fill="none" stroke="#9E7437" stroke-opacity=".22" stroke-width=".35" stroke-linecap="round"/><path d="M33 19.5C35.5 13 42 6.5 50.5 4.2C55.5 2.9 60.8 3.3 62.3 6.2C63.4 8.5 61.2 11.2 59.4 13.6C57 16.8 56.4 20.8 52.6 23.6C47.8 27 40 27.6 33 26.2ZM33 27C38.6 27.4 45.6 28.6 49.6 32C53.2 35.2 52.8 40.2 49.2 42.6C46.6 44.4 43.4 44.2 41.8 46.4C41 47.6 40.6 49.6 39.4 50.4C38.6 49 38.4 47.2 37.6 45.6C35.8 41.6 33.8 36.4 33 31.2Z" fill="none" stroke="#9E7437" stroke-opacity=".5" stroke-width=".7" stroke-linejoin="round"/></g><path d="M31.4 15C29.6 10 27.2 6.8 24.2 4.8M32.6 15C34.4 10 36.8 6.8 39.8 4.8" fill="none" stroke="#5E4830" stroke-width=".6" stroke-linecap="round"/><circle cx="24" cy="4.7" r=".8" fill="#5E4830"/><circle cx="40" cy="4.7" r=".8" fill="#5E4830"/><ellipse cx="32" cy="29.5" rx=".95" ry="10.5" fill="#5E4830"/><ellipse cx="32" cy="20.2" rx="1.35" ry="2.8" fill="#5E4830"/><circle cx="32" cy="16.4" r="1.45" fill="#5E4830"/></svg>';
---
<div class={`btn-circle ${size === 'm' ? 'is-m' : ''} ${cls}`} data-magnetic>
  <div class="btn-circle_label" data-magnetic-inner>
    <span class="nav-item"><span class="nav-item_label"><span class="nav-item_label_text"><span class="l1">{label}</span></span><span class="nav-item_label_text is-2" aria-hidden="true"><span class="l1">{label}</span></span></span></span>
  </div>
  <div class="btn-circle_bg" aria-hidden="true">
    <svg viewBox="0 0 208 208">
      <circle class="btn-circle_arc" cx="104" cy="104" r="103.5" stroke="currentColor" stroke-width="1" fill="none" transform="rotate(-150 104 104)"/>
      <circle class="btn-circle_arc" cx="104" cy="104" r="103.5" stroke="currentColor" stroke-width="1" fill="none" transform="rotate(30 104 104)"/>
      <circle class="btn-circle_ring" cx="104" cy="104" r="103.5" stroke-width="1" fill="none"/>
    </svg>
  </div>
  {butterfly && <span class="bfly" data-butterfly aria-hidden="true" set:html={BFLY}></span>}
  {dialog
    ? <button class="btn-circle_link" type="button" data-open-dialog aria-label={label}></button>
    : <a class="btn-circle_link" href={href} aria-label={label}></a>}
</div>
