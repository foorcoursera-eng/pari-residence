---
/* Круглая кнопка ERA (.btn-circle): подпись l1 в центре, две короткие дуги
   удлиняются при наведении, магнит на десктопе. href — ссылка; dialog — открыть
   окно записи на встречу. butterfly — бабочка прилетает и садится на край круга
   (scripts/butterfly.js; сейчас — только «Изучить расположение»). */
interface Props { label: string; href?: string; dialog?: boolean; size?: 'l' | 'm'; class?: string; butterfly?: boolean }
const { label, href, dialog = false, size = 'l', class: cls = '', butterfly = false } = Astro.props;
/* бабочка сверху вниз головой вверх: два крыла (левое — зеркало правого), тело, усики; тона — золото
   бренда (#C5A059) в шампань, как у лепестков. data-wing — взмахи (JS в полёте, CSS в покое). */
const BFLY = '<svg viewBox="0 0 64 52" width="100%" height="100%"><defs><linearGradient id="bflyG" x1="33" y1="24" x2="61" y2="6" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#A97D2C"/><stop offset=".42" stop-color="#C5A059"/><stop offset="1" stop-color="#F3E8D2"/></linearGradient><linearGradient id="bflyG2" x1="33" y1="27" x2="47" y2="47" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#A97D2C"/><stop offset=".5" stop-color="#C9AD7C"/><stop offset="1" stop-color="#EFE2C6"/></linearGradient></defs><g class="bfly_wing" data-wing><g transform="matrix(-1 0 0 1 64 0)"><path d="M33.2 26.2C39 26.4 46 27.4 50.6 31C54 36 52.2 43.4 46.2 45.4C44.6 46.8 43.6 48.6 41.6 49.6C38.6 45.2 34 38 33.2 30.4Z" fill="url(#bflyG2)"/><path d="M33.2 18C38 10 50 3.4 61 5.4C63.6 11 61 19.6 54.6 24C46 27.6 37.6 27.2 33.2 25Z" fill="url(#bflyG)"/><path d="M34 20.2C42 13.4 50 8.4 59 6.6M34.2 23.2C42 20.4 48.4 17.6 56 17.2M34.4 25.6C41 24.6 47 24.4 52 23M34.2 28.6C39 33.6 42.4 38.2 45 43.4M34 27.4C40 28.6 45.6 30.4 49.6 33.4" fill="none" stroke="#7E5E25" stroke-width=".42" stroke-opacity=".42" stroke-linecap="round"/><path d="M33.2 18C38 10 50 3.4 61 5.4C63.6 11 61 19.6 54.6 24C46 27.6 37.6 27.2 33.2 25ZM33.2 26.2C39 26.4 46 27.4 50.6 31C54 36 52.2 43.4 46.2 45.4C44.6 46.8 43.6 48.6 41.6 49.6C38.6 45.2 34 38 33.2 30.4Z" fill="none" stroke="#7E5E25" stroke-width=".62" stroke-opacity=".8" stroke-linejoin="round"/><path d="M50.5 6.2C55.5 5.4 59.4 5.6 61 5.4C62.4 8.2 62.6 11.4 61.6 14.4" fill="none" stroke="#7E5E25" stroke-width="1.3" stroke-opacity=".32" stroke-linecap="round"/><circle cx="56.8" cy="9" r="1.25" fill="#FFFCF3" fill-opacity=".92"/><circle cx="53" cy="10.6" r=".8" fill="#FFFCF3" fill-opacity=".8"/><circle cx="47.4" cy="39.8" r=".9" fill="#FFFCF3" fill-opacity=".7"/></g></g><g class="bfly_wing" data-wing><path d="M33.2 26.2C39 26.4 46 27.4 50.6 31C54 36 52.2 43.4 46.2 45.4C44.6 46.8 43.6 48.6 41.6 49.6C38.6 45.2 34 38 33.2 30.4Z" fill="url(#bflyG2)"/><path d="M33.2 18C38 10 50 3.4 61 5.4C63.6 11 61 19.6 54.6 24C46 27.6 37.6 27.2 33.2 25Z" fill="url(#bflyG)"/><path d="M34 20.2C42 13.4 50 8.4 59 6.6M34.2 23.2C42 20.4 48.4 17.6 56 17.2M34.4 25.6C41 24.6 47 24.4 52 23M34.2 28.6C39 33.6 42.4 38.2 45 43.4M34 27.4C40 28.6 45.6 30.4 49.6 33.4" fill="none" stroke="#7E5E25" stroke-width=".42" stroke-opacity=".42" stroke-linecap="round"/><path d="M33.2 18C38 10 50 3.4 61 5.4C63.6 11 61 19.6 54.6 24C46 27.6 37.6 27.2 33.2 25ZM33.2 26.2C39 26.4 46 27.4 50.6 31C54 36 52.2 43.4 46.2 45.4C44.6 46.8 43.6 48.6 41.6 49.6C38.6 45.2 34 38 33.2 30.4Z" fill="none" stroke="#7E5E25" stroke-width=".62" stroke-opacity=".8" stroke-linejoin="round"/><path d="M50.5 6.2C55.5 5.4 59.4 5.6 61 5.4C62.4 8.2 62.6 11.4 61.6 14.4" fill="none" stroke="#7E5E25" stroke-width="1.3" stroke-opacity=".32" stroke-linecap="round"/><circle cx="56.8" cy="9" r="1.25" fill="#FFFCF3" fill-opacity=".92"/><circle cx="53" cy="10.6" r=".8" fill="#FFFCF3" fill-opacity=".8"/><circle cx="47.4" cy="39.8" r=".9" fill="#FFFCF3" fill-opacity=".7"/></g><path d="M31.4 14.8C29.6 9.8 27 6.4 23.8 4.4M32.6 14.8C34.4 9.8 37 6.4 40.2 4.4" fill="none" stroke="#3B3024" stroke-width=".72" stroke-linecap="round"/><circle cx="23.6" cy="4.3" r=".95" fill="#3B3024"/><circle cx="40.4" cy="4.3" r=".95" fill="#3B3024"/><ellipse cx="32" cy="29" rx="1.7" ry="11.6" fill="#3B3024"/><ellipse cx="32" cy="19.6" rx="2" ry="2.8" fill="#3B3024"/><circle cx="32" cy="15.6" r="1.9" fill="#3B3024"/></svg>';
---
<div class={`btn-circle ${size === 'm' ? 'is-m' : ''} ${cls}`} data-magnetic>
  <div class="btn-circle_label" data-magnetic-inner>
    <span class="nav-item"><span class="nav-item_label"><span class="nav-item_label_text"><span class="l1">{label}</span></span><span class="nav-item_label_text is-2" aria-hidden="true"><span class="l1">{label}</span></span></span></span>
  </div>
  <div class="btn-circle_bg" aria-hidden="true">
    <svg viewBox="0 0 208 208">
      <circle class="btn-circle_arc" cx="104" cy="104" r="103.5" stroke="currentColor" stroke-width="1" fill="none" transform="rotate(-150 104 104)"/>
      <circle class="btn-circle_arc" cx="104" cy="104" r="103.5" stroke="currentColor" stroke-width="1" fill="none" transform="rotate(30 104 104)"/>
      <circle class="btn-circle_ring" cx="104" cy="104" r="103.5" stroke-width="1" fill="none"/>
    </svg>
  </div>
  {butterfly && <span class="bfly" data-butterfly aria-hidden="true" set:html={BFLY}></span>}
  {dialog
    ? <button class="btn-circle_link" type="button" data-open-dialog aria-label={label}></button>
    : <a class="btn-circle_link" href={href} aria-label={label}></a>}
</div>
