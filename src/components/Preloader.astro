---
/* Загрузочный экран. Композиция по референсу: тёмная тема, знак PARI вверху,
   внизу — подпись «Загрузка», линия прогресса и счётчик 00–100. В центре рамка-арабеска
   (гайдбук §6.1: «окно или вырубка») прорисовывается по мере загрузки; когда всё готово,
   страница раскрывается через окно ровно этой рамки.

   Почему так (замечание заказчика 26.09 «люди должны понимать, что сайт загружается»):
   - стили экрана — прямо здесь, в разметке: он виден с первого кадра, не дожидаясь
     CSS-файлов и шрифтов;
   - счётчик идёт от настоящей загрузки того, что видно на первом экране: шрифты и фото;
     скрипты страницы экран не ждёт (на медленной сети модули приходят позже, а первый
     экран уже можно показать); хотя бы полсекунды экран виден, чтобы не мелькнуть;
   - дольше 2,5 с от начала перехода экран не держит: на плохой сети страница открывается
     и догружается на глазах, фото первого экрана проявляется поверх его основного тона;
   - раскрытие рамкой делает этот же скрипт (CSS-переход), без модулей;
   - в сессии экран показывается один раз: при переходах по сайту его нет (класс pre-skip
     ставится в <head>, до первой отрисовки);
   - без JavaScript экрана нет (noscript в Base.astro), а если скрипт не выполнился,
     экран сам уходит через 8 с (анимация preFailsafe): страница не остаётся закрытой.
   Готовность отдаёт в window.__pariLoader (Promise, резолвится в начале раскрытия)
   и событием pari:reveal; motion.js по нему запускает появление первого экрана. */
import brand from '../data/logo-brand.json';
import { t } from '../i18n/index.js';
const { lang = 'ru' } = Astro.props;
const label = t(lang).ui.loading;
const frameSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${brand.frameBox}"><path d="${brand.frameOuter}" fill="#000"/></svg>`;
const frameUri = `url("data:image/svg+xml,${encodeURIComponent(frameSvg)}")`;
const [, , fw, fh] = brand.frameBox.split(' ').map(Number);
---
<style is:inline>
  @property --hole{syntax:'<length>';inherits:false;initial-value:0px}
  .preloader{position:fixed;inset:0;z-index:11000;display:block;background:#1A1A1A;color:#fff;animation:preFailsafe .6s ease-out 8s both}
  .preloader.is-js{animation:none}
  @keyframes preFailsafe{to{opacity:0;visibility:hidden}}
  .pre-skip .preloader{display:none}
  .preloader.is-opening{
    -webkit-mask:linear-gradient(#000 0 0),var(--frame) 50% 50% / var(--hole) auto no-repeat;-webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0),var(--frame) 50% 50% / var(--hole) auto no-repeat;mask-composite:exclude;
    transition:--hole 1s cubic-bezier(.76,0,.24,1);pointer-events:none;
  }
  .preloader.is-done{display:none}
  .preloader_ctn{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between;padding:0 3vw;transition:opacity .4s cubic-bezier(.25,1,.5,1)}
  .preloader.is-opening .preloader_ctn{opacity:0}
  .preloader_t{display:flex;justify-content:center;padding-top:3vw}
  .preloader_logo{width:max(96px,8vw);aspect-ratio:408.48 / 160.81}
  .preloader_logo svg,.preloader_frame svg{display:block;width:100%;height:100%;overflow:visible}
  .preloader_frame{position:absolute;left:50%;top:50%;width:max(120px,10vw);transform:translate(-50%,-50%)}
  .preloader_frame path{fill:none;stroke:currentColor;stroke-width:1;vector-effect:non-scaling-stroke}
  .preloader_frame_base{opacity:.14;animation:preBreath 2.4s ease-in-out infinite}
  .preloader_frame_draw{stroke-dasharray:1 1;stroke-dashoffset:1}
  @keyframes preBreath{50%{opacity:.34}}
  .preloader_b{display:flex;align-items:center;gap:max(12px,1vw);padding-bottom:3vw;font:600 12px/1.33 Inter,system-ui,-apple-system,'Segoe UI',sans-serif;letter-spacing:.2em;text-transform:uppercase}
  .preloader_progress{flex:1;height:1px;background:rgba(255,255,255,.16);overflow:hidden}
  .preloader_progress_bar{width:100%;height:100%;background:#fff;transform:scaleX(0);transform-origin:0 50%}
  .preloader_count{min-width:3.2em;text-align:right;font-variant-numeric:tabular-nums}
  .preloader_label{opacity:.6}
  @media (max-width:991px){
    .preloader_ctn{padding:0 5.77vw}
    .preloader_t{padding-top:calc(5.77vw + env(safe-area-inset-top,0px))}
    .preloader_logo{width:30vw}
    .preloader_frame{width:34vw}
    .preloader_b{padding-bottom:calc(5.77vw + env(safe-area-inset-bottom,0px));gap:3vw}
  }
  @media (prefers-reduced-motion:reduce){.preloader_frame_base{animation:none}}
</style>
<div class="preloader" data-preloader style={`--frame:${frameUri}`} role="progressbar" aria-label={label} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
  <div class="preloader_ctn" data-preloader-ctn>
    <div class="preloader_t">
      <div class="preloader_logo" aria-hidden="true">
        <svg viewBox={brand.pariBox} fill="currentColor">{brand.pari.map((d) => <path d={d} />)}</svg>
      </div>
    </div>
    <div class="preloader_frame" data-preloader-frame aria-hidden="true" style={`aspect-ratio:${fw} / ${fh}`}>
      <svg viewBox={brand.frameBox}>
        <path class="preloader_frame_base" d={brand.frameOuter} />
        <path class="preloader_frame_draw" d={brand.frameOuter} pathLength="1" data-preloader-draw />
      </svg>
    </div>
    <div class="preloader_b" aria-hidden="true">
      <span class="preloader_label">{label}</span>
      <div class="preloader_progress"><div class="preloader_progress_bar" data-preloader-bar></div></div>
      <span class="preloader_count" data-preloader-count>00</span>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var root = document.documentElement;
    var el = document.querySelector('[data-preloader]');
    var resolve;
    window.__pariLoader = new Promise(function (r) { resolve = r; });
    var revealed = false;
    /* начало раскрытия: первый экран виден, дальше — анимации страницы (motion.js) */
    var reveal = function () {
      if (revealed) return;
      revealed = true;
      window.__pariReveal = performance.now();
      root.classList.add('is-revealed');
      try { sessionStorage.setItem('pari-preloaded', '1'); } catch (e) { /* приватный режим */ }
      resolve();
      document.dispatchEvent(new Event('pari:reveal'));
    };
    if (!el || root.classList.contains('pre-skip')) { if (el) el.classList.add('is-done'); reveal(); return; }
    var MOTION = root.classList.contains('has-motion');
    var bar = el.querySelector('[data-preloader-bar]');
    var cnt = el.querySelector('[data-preloader-count]');
    var draw = el.querySelector('[data-preloader-draw]');
    var frame = el.querySelector('[data-preloader-frame]');

    /* раскрытие окном рамки (CSS-переход --hole); без поддержки @property окно откроется сразу */
    var closed = false;
    var finish = function () { if (closed) return; closed = true; el.classList.add('is-done'); el.setAttribute('aria-hidden', 'true'); };
    var open = function () {
      reveal();
      if (!MOTION) { finish(); return; }
      var start = frame ? frame.getBoundingClientRect().width : 0;
      var end = Math.hypot(window.innerWidth, window.innerHeight) * 2.1;
      el.style.setProperty('--hole', start.toFixed(1) + 'px');
      el.classList.add('is-opening');
      el.getBoundingClientRect();                                    /* начальный размер окна применён — переход пойдёт от него */
      el.style.setProperty('--hole', end.toFixed(1) + 'px');
      el.addEventListener('transitionend', function (e) { if (e.target === el) finish(); });
      setTimeout(finish, 1300);                                      /* transitionend может не прийти (вкладка скрыта, нет @property) */
    };

    /* этапы и их вес: шрифты и фото первого экрана */
    var got = { fonts: 0, hero: 0 };
    var W = { fonts: .35, hero: .5 };
    var base = .1, target = base, shown = 0, t0 = performance.now(), tStage = t0, ready = false, last = t0, fin = 0, pct0 = -1;
    var stage = function (k) {
      if (got[k]) return;
      got[k] = 1; tStage = performance.now();
      target = base + W.fonts * got.fonts + W.hero * got.hero;
      if (got.fonts && got.hero) ready = true;
    };
    /* шрифты первого экрана: ждём крупную антикву (её подмена заметна) и на главной — каллиграфию;
       мелкий Inter догружается сам (с запасным шрифтом он почти не отличается). Наборы знаков разбиты
       по unicode-range, поэтому образец текста — с кириллицей на русских страницах */
    var f = document.fonts;
    var sample = root.lang === 'ru' ? 'Aa Жж' : 'Aa';
    if (f && f.load) {
      Promise.all([f.load('500 1em "Cormorant Garamond"', sample), root.hasAttribute('data-script-font') ? f.load('1em "Pinyon Script"', 'Aa') : null])
        .then(function () { stage('fonts'); }, function () { stage('fonts'); });
    } else stage('fonts');
    /* фото первого экрана: загружено и раскодировано. Ищем его в каждом кадре, пока разбирается разметка;
       на страницах без такого фото этап засчитывается, когда разметка разобрана. */
    var heroSeen = false;
    var watchHero = function () {
      if (heroSeen) return;
      var img = document.querySelector('img[data-critical]');
      if (!img) { if (document.readyState !== 'loading') { heroSeen = true; stage('hero'); } return; }
      heroSeen = true;
      var ok = function () { (img.decode ? img.decode() : Promise.resolve()).then(function () { stage('hero'); }, function () { stage('hero'); }); };
      if (img.complete && img.naturalWidth) ok();
      else { img.addEventListener('load', ok, { once: true }); img.addEventListener('error', function () { stage('hero'); }, { once: true }); }
    };
    /* потолок: 2,5 с от начала перехода — дальше страница открывается и догружается на глазах */
    var CAP = 2500, MIN = 500;
    setTimeout(function () { ready = true; }, Math.max(MIN, CAP - performance.now()));
    setTimeout(open, 10000);                                         /* страховка: кадры не шли (скрытая вкладка) */

    var tick = function (now) {
      try {
        var dt = Math.min(.1, (now - last) / 1000); last = now;
        watchHero();
        var cap;
        if (ready && now - t0 > MIN) cap = 1;
        else {
          /* пока ждём, счётчик понемногу ползёт к следующему этапу, но не доходит до него */
          var rest = (got.fonts ? 0 : W.fonts) + (got.hero ? 0 : W.hero);
          cap = Math.min(.97, target + rest * .6 * (1 - Math.exp(-(now - tStage) / 1800)));
        }
        shown += (cap - shown) * Math.min(1, dt * (cap === 1 ? 14 : 3.2));   /* всё готово — счётчик добегает за ~0,25 с */
        if (cap === 1 && 1 - shown < .01) shown = 1;
        var pct = Math.floor(shown * 100);
        if (pct !== pct0) {
          pct0 = pct;
          cnt.textContent = pct < 10 ? '0' + pct : String(pct);
          el.setAttribute('aria-valuenow', String(pct));
        }
        bar.style.transform = 'scaleX(' + shown.toFixed(4) + ')';
        if (draw) draw.style.strokeDashoffset = String((1 - shown).toFixed(4));
        if (shown === 1) {
          if (!fin) fin = now;
          if (now - fin > 90) { open(); return; }                    /* «100» задерживается на мгновение */
        }
      } catch (e) { open(); return; }
      requestAnimationFrame(tick);
    };
    el.classList.add('is-js');                                       /* дальше экраном управляет скрипт: аварийная анимация не нужна */
    requestAnimationFrame(tick);
  })();
</script>
